# MongoDB connection
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<app>
MONGODB_DB_NAME=ai_pulse

# OpenAI API
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# Admin authentication (generate a random key: python -c "import secrets; print(secrets.token_urlsafe(32))")
ADMIN_API_KEY=your-admin-key-here

# Application
APP_ENV=development
APP_PORT=8000
